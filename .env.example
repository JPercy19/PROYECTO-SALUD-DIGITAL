# ============================================================
# PROYECTO SALUD DIGITAL - Variables de Entorno
# Copia este archivo como ".env" y rellena los valores reales
# ============================================================

# --- Base de datos PostgreSQL ---
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/salud_digital

# --- Clave de encriptación (generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=TU_CLAVE_FERNET_AQUI

# --- API Keys de administrador (crear claves largas y aleatorias)
ADMIN_ACCESS_KEY=tu-access-key-secreta-larga
ADMIN_PERMISSION_KEY=tu-permission-key-secreta-larga

# --- Configuración Flask ---
FLASK_ENV=development
FLASK_SECRET_KEY=tu-clave-secreta-flask

# --- Rate limiting ---
RATELIMIT_STORAGE_URL=memory://

# --- Puerto del servidor backend ---
BACKEND_PORT=5000

# --- URL del backend (usada por el frontend Streamlit) ---
BACKEND_URL=http://localhost:5000
